{
  "name": "ishwar-books",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "content:watch": "node --watch-path=content --watch-path=scripts scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
